+  .manager-request-heading { align-items: flex-start; }
+  .manager-request-heading p { max-width: 28ch; }
+  .manager-request-refresh { min-height: 37px; padding-inline: 8px; font-size: 10px; }
+  .manager-request-person { flex-wrap: wrap; }
+  .manager-request-status { margin-left: auto; }
+  .manager-join-request-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
+  .manager-join-request-actions button { min-width: 0; }
+  .hostel-invite-page { align-content: start; padding-inline: 12px; gap: 12px; }
+  .hostel-invite-card { padding: 21px 17px; border-radius: 20px; }
+  .hostel-invite-card > h1 { font-size: 23px; }
+  .hostel-invite-lead { font-size: 12px; }
+  .hostel-invite-topbar > span { font-size: 10px; }
+  .hostel-invite-exit { min-height: 34px; padding-inline: 9px; }
+  .onboarding-linked-request { grid-template-columns: 34px minmax(0, 1fr); gap: 9px; padding: 12px; }
+  .onboarding-linked-request-icon { width: 34px; height: 34px; border-radius: 10px; }
+  .onboarding-linked-request-copy h2 { font-size: 16px; }
+  .platform-navigation-heading { align-items: flex-start; flex-direction: column; gap: 2px; }
+  .platform-navigation .platform-main-tabs,
+  .platform-navigation .platform-config-tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .platform-navigation .platform-tabs button { min-height: 44px; padding: 8px 6px; font-size: 11px; }
+  .platform-settings-intro { margin-top: 14px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .manager-invite-card *,
+  .manager-join-request-panel *,
+  .hostel-invite-card * { scroll-behavior: auto !important; transition: none !important; }
+}
