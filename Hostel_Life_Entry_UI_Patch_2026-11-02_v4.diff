+
+.platform-page .platform-stat > div {
+  z-index: 1;
+  gap: 7px;
+}
+
+.platform-page .platform-stat small {
+  font-size: 12px;
+  font-weight: 750;
+  line-height: 1.45;
+}
+
+.platform-page .platform-stat strong {
+  font-variant-numeric: tabular-nums;
+  letter-spacing: -.025em;
+}
+
+.platform-page .platform-privacy-note {
+  min-height: 88px;
+  align-items: center;
+  border: 1px solid #dcece3;
+  border-radius: 17px;
+  background: linear-gradient(115deg, #f1faf5, #fbfdfb);
+}
+
+.platform-page .platform-privacy-note > svg {
+  flex: 0 0 auto;
+  width: 42px;
+  height: 42px;
+  padding: 10px;
+  border-radius: 13px;
+  background: #e1f3e8;
+}
+
+.platform-page .platform-panel {
+  box-shadow: 0 10px 28px rgba(24, 60, 42, .055);
+}
+
+.platform-page .platform-panel-heading {
+  padding-bottom: 15px;
+  border-bottom: 1px solid #edf2ee;
+}
+
+.platform-page .platform-panel-heading > div {
+  min-width: 0;
+}
+
+.platform-page .platform-panel-heading .eyebrow {
+  display: inline-flex;
+  align-items: center;
+  margin-bottom: 5px;
+  padding: 4px 8px;
+  border-radius: 7px;
+  background: #eff7f2;
+  color: #287052;
+  font-size: 10px;
+  font-weight: 900;
+  letter-spacing: .06em;
+}
+
+.platform-page .platform-panel-heading h3 {
+  letter-spacing: -.02em;
+}
+
+.platform-page .platform-panel-heading p {
+  max-width: 82ch;
+}
+
+.platform-page .platform-filter-pills button {
+  transition: background .16s ease, border-color .16s ease, color .16s ease, box-shadow .16s ease;
+}
+
+.platform-page .platform-filter-pills button:not(.active):hover {
+  border-color: #9bcbb2;
+  background: #eff8f2;
+  color: #17644f;
+}
+
+.platform-page .platform-status {
+  font-variant-numeric: tabular-nums;
+}
+
+.platform-page .platform-empty-state {
+  border: 1px dashed #d6e5dc;
+  border-radius: 16px;
+  background: #fbfdfb;
+}
+
+.platform-page .platform-empty-state > svg {
+  width: 48px;
+  height: 48px;
+  padding: 12px;
+  border-radius: 15px;
+  background: #eff7f2;
+  color: #277052;
+}
+
+.platform-page .platform-report-table-wrap {
+  scrollbar-width: thin;
+  scrollbar-color: #b6d1c1 #f4f8f5;
+}
+
+.platform-page .platform-report-table th {
+  position: sticky;
+  top: 0;
+  z-index: 1;
+}
+
+.platform-page .platform-report-table tbody tr:hover td {
+  background: #f5faf6;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .platform-page .platform-stat:hover {
+    transform: translateY(-2px);
+    border-color: #c1ddcc;
+    box-shadow: 0 12px 27px rgba(24, 60, 42, .09);
+  }
+}
+
+@media (max-width: 1100px) {
+  .platform-page .platform-tabs {
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 760px) {
+  .platform-page .platform-tabs {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+  .platform-stats-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .platform-overview-heading {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+}
+
+@media (max-width: 520px) {
+  .platform-page .platform-tabs {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 7px;
+    padding: 7px;
+  }
+  .platform-page .platform-tabs button {
+    min-height: 48px;
+    padding: 9px 7px;
+    font-size: 12px;
+  }
+  .platform-stats-grid {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 10px;
+  }
+  .platform-page .platform-stat {
+    min-height: 92px;
+    padding: 16px;
+  }
+  .platform-page .platform-stat strong {
+    font-size: 26px;
