+  line-height: 1.45;
+}
+
+.platform-page .platform-auth-user {
+  display: inline-block;
+  max-width: min(36vw, 420px);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  padding: 8px 11px;
+  border: 1px solid #e4eee8;
+  border-radius: 999px;
+  background: #f6faf7;
+  color: #45675a;
+  font-size: 12px;
+}
+
+.platform-page .platform-intro {
+  position: relative;
+  overflow: hidden;
+  isolation: isolate;
+}
+
+.platform-page .platform-intro::after {
+  position: absolute;
+  z-index: -1;
+  top: -58px;
+  right: -38px;
+  width: 190px;
+  height: 190px;
+  border: 1px solid rgba(255,255,255,.12);
+  border-radius: 50%;
+  box-shadow: 0 0 0 24px rgba(255,255,255,.035), 0 0 0 50px rgba(255,255,255,.025);
+  content: "";
+  pointer-events: none;
+}
+
+.platform-overview-heading {
+  width: min(1380px, 100%);
+  margin: 22px auto 13px;
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 16px;
+}
+
+.platform-overview-heading h3 {
+  margin: 5px 0 4px;
+  color: #183f33;
+  font-size: clamp(20px, 2.4vw, 27px);
+  font-weight: 900;
+  letter-spacing: -.025em;
+  line-height: 1.3;
+}
+
+.platform-overview-heading p {
+  max-width: 68ch;
+  margin: 0;
+  color: #63796f;
+  font-size: 13px;
+  line-height: 1.65;
+}
+
+.platform-overview-tag {
+  flex: 0 0 auto;
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  padding: 8px 11px;
+  border: 1px solid #dcece3;
+  border-radius: 999px;
+  background: #f2faf5;
+  color: #23674d;
+  font-size: 11px;
+  font-weight: 850;
+  white-space: nowrap;
+}
+
+.platform-page .platform-tabs {
+  display: grid;
+  grid-template-columns: repeat(6, minmax(0, 1fr));
+  align-items: stretch;
+  overflow: visible;
+  padding: 9px;
+}
+
+.platform-page .platform-tabs button {
+  min-width: 0;
+  min-height: 48px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 9px 10px;
+  line-height: 1.4;
+  text-align: center;
+  white-space: normal;
+  overflow-wrap: anywhere;
+}
+
+.platform-page .platform-tabs button:focus-visible,
+.platform-page .platform-header-actions button:focus-visible,
+.platform-page .platform-filter-pills button:focus-visible {
+  outline: 3px solid #75c9a4;
+  outline-offset: 3px;
+}
+
+.platform-stats-grid {
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 245px), 1fr));
+  align-items: stretch;
+  gap: 15px;
+}
+
+.platform-page .platform-stat {
+  min-height: 112px;
+  position: relative;
+  overflow: hidden;
+  gap: 15px;
+  padding: 20px;
+  transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
+}
+
+.platform-page .platform-stat::after {
+  position: absolute;
+  right: -22px;
+  bottom: -34px;
+  width: 94px;
+  height: 94px;
+  border-radius: 50%;
+  background: #eaf5ef;
+  content: "";
+  pointer-events: none;
+}
+
+.platform-page .platform-stat-icon {
+  z-index: 1;
+  width: 48px;
+  height: 48px;
+  border: 1px solid #dcefe3;
+  border-radius: 15px;
+  background: #eef8f1;
