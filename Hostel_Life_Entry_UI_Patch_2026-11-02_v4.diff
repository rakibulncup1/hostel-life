+/*
+ * Hostel Life — Public Entry Experience
+ * Scoped to Login, Registration and first-time hostel setup.
+ * Presentation only: no auth, RPC, membership or billing behavior is changed.
+ */
+
+.auth-page,
+.onboarding-page {
+  min-height: 100svh;
+  overflow-x: clip;
+  padding-top: max(16px, env(safe-area-inset-top));
+  padding-bottom: max(22px, env(safe-area-inset-bottom));
+}
+
+.auth-shell:not(.auth-shell-compact) {
+  width: min(1040px, 100%);
+  border-radius: 28px;
+}
+
+.auth-form-toolbar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin: 0 0 18px;
+}
+
+.auth-form-toolbar-label {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  min-width: 0;
+  color: var(--muted);
+  font-size: 11px;
+  font-weight: 800;
+  letter-spacing: .01em;
+}
+
+.auth-form-toolbar-label svg { flex: 0 0 auto; color: var(--primary-strong); }
+.auth-form-panel .auth-form-intro { margin-bottom: 18px; }
+.auth-form-panel .auth-header { margin-bottom: 23px; }
+.auth-form-panel .field-label { min-width: 0; }
+.auth-form-panel .field-label input,
+.auth-form-panel .password-field input { min-width: 0; width: 100%; }
+.auth-form-panel .password-field { min-width: 0; }
+.auth-form-panel .primary-button.large { min-height: 52px; }
+.auth-form-panel .auth-switch { line-height: 1.6; }
+
+.auth-register-form { gap: 13px; }
+.auth-register-form .two-field-grid { gap: 12px; }
+.auth-register-form .field-label { gap: 6px; }
+.auth-register-form .register-email-note {
+  display: block;
+  margin: 0;
+  color: var(--muted);
+  font-size: 11px;
+  font-weight: 500;
+  line-height: 1.55;
+}
+.auth-shell-register .auth-form-panel { justify-content: flex-start; }
+.auth-shell-register .auth-brand-panel { justify-content: center; }
+
+.entry-theme-switcher {
+  position: relative;
+  z-index: 30;
+  flex: 0 0 auto;
+  color: var(--text);
+}
+.entry-theme-switcher > summary {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  min-height: 38px;
+  padding: 7px 10px;
+  border: 1px solid var(--line);
+  border-radius: 11px;
+  background: var(--surface);
+  color: var(--text);
+  cursor: pointer;
+  list-style: none;
+  font-size: 11px;
+  font-weight: 800;
+  white-space: nowrap;
+  user-select: none;
+  transition: border-color .18s, background .18s, box-shadow .18s;
+}
+.entry-theme-switcher > summary::-webkit-details-marker { display: none; }
+.entry-theme-switcher > summary:hover { border-color: var(--primary); }
+.entry-theme-switcher > summary:focus-visible { outline: 3px solid color-mix(in srgb, var(--primary) 26%, transparent); outline-offset: 2px; }
+.entry-theme-switcher > summary > svg:first-child { color: var(--primary-strong); }
+.entry-theme-switcher > summary strong { font-size: 11px; font-weight: 850; }
+.entry-theme-chevron { color: var(--muted); transition: transform .18s; }
+.entry-theme-switcher[open] .entry-theme-chevron { transform: rotate(180deg); }
+.entry-theme-menu {
+  position: absolute;
+  top: calc(100% + 8px);
+  right: 0;
+  width: 205px;
+  padding: 9px;
+  border: 1px solid var(--line);
+  border-radius: 15px;
+  background: var(--surface);
+  box-shadow: 0 18px 42px rgba(10, 30, 20, .18);
+}
+.entry-theme-menu-title {
+  display: block;
+  padding: 5px 8px 8px;
+  color: var(--muted);
+  font-size: 10px;
+  font-weight: 850;
+  letter-spacing: .04em;
+}
+.entry-theme-option {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  width: 100%;
+  min-height: 39px;
+  padding: 8px 9px;
+  border: 1px solid transparent;
+  border-radius: 10px;
+  background: transparent;
+  color: var(--text);
+  cursor: pointer;
+  text-align: left;
+  font-size: 12px;
+  font-weight: 750;
+}
+.entry-theme-option > span { flex: 1; }
+.entry-theme-option > svg:first-child { color: var(--muted); }
+.entry-theme-option > svg:last-child:not(:first-child) { color: var(--primary-strong); }
+.entry-theme-option:hover { background: var(--surface-2); }
+.entry-theme-option.selected {
+  border-color: color-mix(in srgb, var(--primary) 25%, var(--line));
+  background: color-mix(in srgb, var(--primary-soft) 75%, var(--surface));
+  color: var(--primary-strong);
+}
+
+/* First-time setup: one concise choice row and one active form, not two tall cards. */
+.onboarding-page { place-items: start center; }
+.onboarding-shell { width: min(860px, 100%); }
+.onboarding-main-card {
+  padding: clamp(18px, 3.3vw, 34px);
+  border-radius: 26px;
+}
+.onboarding-topbar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin: 0 0 9px;
+}
+.onboarding-topbar > span {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  min-width: 0;
+  color: var(--muted);
+  font-size: 11px;
+  font-weight: 800;
+}
+.onboarding-topbar > span svg { flex: 0 0 auto; color: var(--primary-strong); }
+.onboarding-brand-header { padding: 3px 8px 20px; }
+.onboarding-brand-logo { width: 70px; height: 70px; border-radius: 21px; }
+.onboarding-brand-logo svg { width: 53px; height: 53px; }
+.onboarding-brand-header h1 { font-size: clamp(23px, 3.8vw, 32px); }
+.onboarding-brand-header p { max-width: 560px; font-size: 13px; }
+.onboarding-account-switch-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin: 16px 0 21px;
+  padding: 10px 12px;
+}
+.onboarding-account-switch-row > span { font-size: 11px; line-height: 1.55; }
+.onboarding-account-switch-row .onboarding-switch-account {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  flex: 0 0 auto;
+  min-height: 38px;
+  padding: 7px 11px;
+  cursor: pointer;
+}
+.onboarding-choice-intro { margin: 0 0 12px; }
+.onboarding-choice-intro .eyebrow { font-size: 10px; font-weight: 900; letter-spacing: .08em; }
+.onboarding-choice-intro h2 { margin-top: 5px; font-size: clamp(19px, 2.7vw, 23px); }
+.onboarding-choice-intro p { margin-top: 4px; font-size: 11px; }
+.onboarding-mode-picker {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 10px;
+}
+.onboarding-mode-option {
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  min-width: 0;
+  min-height: 72px;
+  padding: 12px 13px;
+  border: 1px solid var(--line);
+  border-radius: 15px;
+  background: var(--surface);
+  color: var(--text);
+  cursor: pointer;
+  text-align: left;
+  transition: border-color .18s, background .18s, box-shadow .18s, transform .18s;
+}
+.onboarding-mode-option:hover { border-color: color-mix(in srgb, var(--primary) 42%, var(--line)); }
+.onboarding-mode-option.active {
+  border-color: color-mix(in srgb, var(--primary) 62%, var(--line));
+  background: color-mix(in srgb, var(--primary-soft) 62%, var(--surface));
+  box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 9%, transparent);
+}
+.onboarding-mode-icon {
+  display: grid;
+  place-items: center;
+  flex: 0 0 39px;
+  width: 39px;
+  height: 39px;
+  border-radius: 12px;
+  background: var(--surface-2);
+  color: var(--primary-strong);
+}
+.onboarding-mode-option.active .onboarding-mode-icon { background: var(--primary-soft); }
