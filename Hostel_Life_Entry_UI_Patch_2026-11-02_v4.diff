+  .platform-overview-heading {
+    margin-top: 16px;
+    gap: 9px;
+  }
+  .platform-overview-heading p {
+    font-size: 12px;
+  }
+  .platform-overview-tag {
+    font-size: 10px;
+  }
+  .platform-page .platform-header-actions {
+    width: 100%;
