# Supabase public client settings
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional: set only after the signed Cloudflare Worker is deployed.
# Leave blank to use the direct Supabase Edge Function path.
VITE_HOSTEL_SECURITY_WORKER_URL=

# Google OAuth UI stays hidden until Google Cloud and Supabase are fully configured.
# This is a public feature flag, not a secret. Never put a Google Client Secret here.
VITE_GOOGLE_OAUTH_ENABLED=false
# Public Google Web Client ID only; never place the Google Client Secret in a VITE_ variable.
VITE_GOOGLE_CLIENT_ID=
