name = "hostel-life-security-proxy"
main = "src/index.js"
compatibility_date = "2026-11-06"
workers_dev = true

# Set these in the Cloudflare Worker Dashboard or replace the example values
# before `wrangler deploy`. Do NOT put HOSTEL_GEO_PROXY_HMAC_SECRET here.
[vars]
SUPABASE_FUNCTIONS_ORIGIN = "https://YOUR_PROJECT_REF.supabase.co"
ALLOWED_ORIGINS = "https://your-production-domain.example,http://localhost:5173"
