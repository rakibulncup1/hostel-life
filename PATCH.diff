+.telegram-nudge-dialog .eyebrow { display: block; margin-bottom: 7px; color: var(--primary-strong); font-size: 10px; font-weight: 850; letter-spacing: .08em; }
+.telegram-nudge-dialog h2 { margin: 0 35px 9px 0; font-size: clamp(19px, 4vw, 23px); line-height: 1.35; font-weight: 850; }
+.telegram-nudge-dialog p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.75; }
+.telegram-nudge-actions { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 19px; }
+.telegram-nudge-actions .primary-button { flex: 1 1 190px; justify-content: center; }
+.offline-recovery-state { width: min(100%, 760px); margin: clamp(24px, 7vh, 72px) auto; }
+@media (max-width: 620px) {
+  .telegram-nudge-dialog { padding: 22px 19px; }
+  .offline-recovery-state { width: 100%; margin: 12px 0; }
+}
